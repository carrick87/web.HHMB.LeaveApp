rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Branch catalog — authenticated read; Super Admin write
    match /branches/{branchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }

    // Allow authenticated Admin/Super Admin to manage employee master (branch register + upload)
    match /employees/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }
    
    // Users collection - users can read their own data, admins can read all
    // Allow create for sign-up (user is authenticated after Firebase Auth creates account)
    match /users/{userId} {
      function requesterDoc() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function getRequesterRole() {
        return requesterDoc().role;
      }
      function isSuperAdmin() {
        return getRequesterRole() == 'Super Admin';
      }
      function isAdmin() {
        return getRequesterRole() == 'Admin';
      }
      function adminBranchCodes() {
        return ('branches' in requesterDoc() && requesterDoc().branches is list && requesterDoc().branches.size() > 0)
          ? requesterDoc().branches
          : (('branchOverride' in requesterDoc() && requesterDoc().branchOverride is string && requesterDoc().branchOverride.size() > 0)
            ? [requesterDoc().branchOverride]
            : (('branch' in requesterDoc() && requesterDoc().branch is string && requesterDoc().branch.size() > 0)
              ? [requesterDoc().branch]
              : [requesterDoc().employeeNumber[0:2]]));
      }
      function targetUserBranch() {
        return ('branchOverride' in resource.data && resource.data.branchOverride is string && resource.data.branchOverride.size() > 0)
          ? resource.data.branchOverride
          : (('branch' in resource.data && resource.data.branch is string && resource.data.branch.size() > 0)
            ? resource.data.branch
            : resource.data.employeeNumber[0:2]);
      }
      // Admin may only set isActive / departmentId on Normal users in assigned branches
      function adminCanManageNormalUser() {
        return isAdmin()
          && resource.data.role == 'Normal'
          && request.resource.data.role == 'Normal'
          && targetUserBranch() in adminBranchCodes()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isActive', 'departmentId', 'updatedAt']);
      }

      // Allow reading own data or if admin/super admin
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );

      // Allow creating own user document, or Admin/Super Admin provisioning accounts
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSuperAdmin()
      );

      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        adminCanManageNormalUser()
      );

      allow delete: if request.auth != null && isSuperAdmin();
    }
    
    // Allow querying users collection to check for duplicate employee numbers during sign-up
    // This allows unauthenticated users to check if an employee number already exists
    // This is necessary to prevent duplicate employee numbers during registration
    // We allow list queries on the users collection for this specific use case
    match /users/{document=**} {
      // Allow list queries for checking employeeNumber duplicates
      // This is needed for sign-up validation - prevents duplicate employee numbers
      // The query filters by employeeNumber field, so it's safe to allow
      allow list: if true; // Allow queries to check for duplicate employee numbers
    }
    
    // Departments - authenticated users can read; Super Admin full write;
    // Admin can create/update for assigned branches; delete is Super Admin only
    match /departments/{document=**} {
      function requesterDoc() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function requesterRole() {
        return requesterDoc().role;
      }
      function isSuperAdmin() {
        return requesterRole() == 'Super Admin';
      }
      function isAdmin() {
        return requesterRole() == 'Admin';
      }
      function adminBranchCodes() {
        return ('branches' in requesterDoc() && requesterDoc().branches is list && requesterDoc().branches.size() > 0)
          ? requesterDoc().branches
          : (('branchOverride' in requesterDoc() && requesterDoc().branchOverride is string && requesterDoc().branchOverride.size() > 0)
            ? [requesterDoc().branchOverride]
            : [requesterDoc().employeeNumber[0:2]]);
      }
      function adminCanCreateDepartment() {
        return isAdmin()
          && request.resource.data.keys().hasAll(['name', 'branch'])
          && request.resource.data.branch is string
          && request.resource.data.branch in adminBranchCodes();
      }
      // Admin may update departments only when both the existing and new branch
      // codes are in their assigned branches (User Management `branches`).
      function adminCanUpdateDepartment() {
        return isAdmin()
          && 'branch' in resource.data
          && resource.data.branch is string
          && resource.data.branch in adminBranchCodes()
          && 'branch' in request.resource.data
          && request.resource.data.branch is string
          && request.resource.data.branch in adminBranchCodes();
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && (isSuperAdmin() || adminCanCreateDepartment());
      allow update: if request.auth != null && (isSuperAdmin() || adminCanUpdateDepartment());
      allow delete: if request.auth != null && isSuperAdmin();
    }
    
    // Leave requests - users can read their own, approvers can read department requests
    match /leaveRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Email config - all authenticated users can read (needed for sending emails), only admins can write
    match /emailConfig/{document=**} {
      allow read: if request.auth != null; // All authenticated users can read email config
      allow write: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
    
    // Email config with underscore - all authenticated users can read, only admins can write
    match /email_config/{document=**} {
      allow read: if request.auth != null; // All authenticated users can read email config
      allow write: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
    
    // Email templates - all authenticated users can read (needed for sending emails), only admins can write
    match /email_templates/{document=**} {
      allow read: if request.auth != null; // All authenticated users can read email templates
      allow write: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
    
    // Config collection - admins only
    match /config/{document=**} {
      allow read, write: if request.auth != null && 
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
    
    // Leave type configurations - all authenticated users can read (needed for leave application), only Super Admin can write
    match /leaveTypeConfigs/{document=**} {
      allow read: if request.auth != null; // All authenticated users can read leave type configs
      allow write: if request.auth != null && 
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
    
    // Leave balance history - users can read their own, admins can read/write all
    match /leaveBalanceHistory/{historyId} {
      // Helper function to get user document
      function getUserDoc() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid));
      }
      
      // Helper function to get user role
      function getUserRole() {
        return getUserDoc().data.role;
      }
      
      // Helper function to get user's employee number
      function getUserEmployeeNumber() {
        return getUserDoc().data.employeeNumber;
      }
      
      // Allow reading if:
      // 1. User is reading their own record (employeeNumber matches), OR
      // 2. User is ADMIN or SUPER_ADMIN
      allow read: if request.auth != null && (
        (resource.data.employeeNumber != null && 
         resource.data.employeeNumber == getUserEmployeeNumber()) ||
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
      
      // Allow writing only for ADMIN and SUPER_ADMIN
      allow write: if request.auth != null && (
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
    }
    
    // Leave balance current (reference table) - authenticated users can read (queries filter by employeeNumber), admins can write
    match /leaveBalanceCurrent/{currentId} {
      // Helper function to get user document
      function getUserDoc() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid));
      }
      
      // Helper function to get user role
      function getUserRole() {
        return getUserDoc().data.role;
      }
      
      // Allow reading for all authenticated users (queries filter by employeeNumber, so users can only access their own)
      // This is needed during sign-up when user document doesn't exist yet
      allow read: if request.auth != null;
      
      // Allow create, update, and delete only for ADMIN and SUPER_ADMIN
      allow create: if request.auth != null && (
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
      
      allow update: if request.auth != null && (
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
      
      allow delete: if request.auth != null && (
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
    }
    
    // Public holiday sets - all authenticated users can read (needed for leave calculations), admins can write
    match /publicHolidaySets/{setId} {
      // Helper function to get user document (returns null if doesn't exist)
      function getUserDoc() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
          ? get(/databases/$(database)/documents/users/$(request.auth.uid))
          : null;
      }
      
      // Helper function to get user role (returns null if user doc doesn't exist)
      function getUserRole() {
        let userDoc = getUserDoc();
        return userDoc != null ? userDoc.data.role : null;
      }
      
      // Allow reading (including list queries) for all authenticated users (needed for leave calculations)
      allow read, list: if request.auth != null;
      
      // Allow create, update, and delete only for ADMIN and SUPER_ADMIN
      allow create: if request.auth != null && 
                   getUserDoc() != null && (
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
      
      allow update: if request.auth != null && 
                   getUserDoc() != null && (
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
      
      allow delete: if request.auth != null && 
                   getUserDoc() != null && (
        getUserRole() == 'Admin' ||
        getUserRole() == 'Super Admin'
      );
    }

    // Provisioned Google accounts — Admin SDK writes; signed-in user may read/claim their own invite
    match /provisionedUsers/{emailId} {
      function requesterDoc() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }
      function isSuperAdmin() {
        return requesterDoc().role == 'Super Admin';
      }
      function isAdmin() {
        return requesterDoc().role == 'Admin';
      }
      function authEmail() {
        return request.auth.token.email != null
          ? request.auth.token.email.lower()
          : '';
      }

      allow read: if request.auth != null && (
        emailId == authEmail() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (isAdmin() || isSuperAdmin()))
      );

      // Claim invite on first Google sign-in (set claimedUid only)
      allow update: if request.auth != null
        && emailId == authEmail()
        && resource.data.email == authEmail()
        && (!('claimedUid' in resource.data) || resource.data.claimedUid == null || resource.data.claimedUid == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid', 'updatedAt']);

      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (isAdmin() || isSuperAdmin())
        && request.resource.data.keys().hasAll(['email', 'employeeNumber', 'name', 'payGroup'])
        && request.resource.data.email == emailId
        && request.resource.data.email.matches('.*@harrisons\\.com\\.my');

      allow delete: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isSuperAdmin();
    }

    // Written only by Cloud Functions (Admin SDK). Clients must not read or write.
    match /passwordResetAttempts/{document=**} {
      allow read, write: if false;
    }
  }
}
