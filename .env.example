# Firebase (required) — from Firebase Console > Project settings > Your apps
# Project: web-hhmb-leaveapp
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=web-hhmb-leaveapp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=web-hhmb-leaveapp
VITE_FIREBASE_STORAGE_BUCKET=web-hhmb-leaveapp.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Restrict Google Sign-In / provisioning to company domain
VITE_ALLOWED_EMAIL_DOMAIN=harrisons.com.my

# Firebase Cloud Functions base URL (registerBranchEmployees)
# Example: https://us-central1-web-hhmb-leaveapp.cloudfunctions.net
VITE_FUNCTIONS_URL=

# Optional: Google Gemini (leave reason suggestions)
GEMINI_API_KEY=

# Optional: Google Drive attachments
REACT_APP_GOOGLE_DRIVE_API_KEY=
REACT_APP_GOOGLE_DRIVE_FOLDER_ID=
