# Firebase (required) — from Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: restrict signup to one email domain (e.g. company.com). Leave empty to allow any domain.
VITE_ALLOWED_EMAIL_DOMAIN=

# Optional: Firebase Cloud Functions base URL for admin password reset
# Example: https://us-central1-your-project-id.cloudfunctions.net
VITE_FUNCTIONS_URL=

# Optional: Google Gemini (leave reason suggestions)
GEMINI_API_KEY=

# Optional: Google Drive attachments
REACT_APP_GOOGLE_DRIVE_API_KEY=
REACT_APP_GOOGLE_DRIVE_FOLDER_ID=
